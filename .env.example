# ---- 동기화 ----
# 기본 방식: VPS 의 비서(OpenClaw)가 이 PC 의 OpenClaw 노드를 통해 inbox 폴더에 파일을 넣고, 앱이 30초 안에 자동 반영합니다.
# inbox 폴더. 비우면 앱 폴더 안 .data/inbox. 설치 도우미는 문서\openclaw-dashboard\inbox 로 잡습니다(Hub 앱 샌드박스가 Documents 를 열어 줄 수 있어서).
DASHBOARD_INBOX_DIR=
# 아래 두 값은 **필요 없습니다**. (구버전 "당겨오기" 방식을 쓸 때만 설정)
OPENCLAW_SYNC_URL=
OPENCLAW_GATEWAY_TOKEN=

# ---- 선택 ----
# 다른 사람에게 노출되는 경로(Tailscale Serve 등)로 열 때만 설정. 일반 HTTP 인터넷에 노출 금지.
DASHBOARD_PASSWORD=

# 텔레그램 전사 → /api/ingest 용. 긴 임의 문자열.
DASHBOARD_INGEST_TOKEN=

# 왼쪽 상단 이름의 초기값. 동기화하면 VPS 쪽 이름으로 바뀐다(설정에서 다시 변경 가능).
NEXT_PUBLIC_DASHBOARD_NAME=내 AI 오피스
