# ---- 동기화 (VPS 의 OpenClaw 에서 대시보드 데이터를 당겨온다) ----
# dashboard-builder 스킬이 VPS 의 ~/.openclaw/workspace/canvas/dashboard/ 에 쓴 파일을 가져온다.
# <VPS Tailscale IP> 는 `tailscale status` 에서 VPS 줄의 100.x.y.z. 포트는 게이트웨이 포트(기본 18789).
OPENCLAW_SYNC_URL=http://100.0.0.0:18789/__openclaw__/canvas/dashboard/

# 게이트웨이 토큰. hPanel(호스팅어) 또는 `openclaw config get gateway.auth.token` 에서 복사.
# 이 파일은 Git 에서 제외되며 브라우저로 전송되지 않는다. 절대 채팅·문서에 붙여넣지 말 것.
OPENCLAW_GATEWAY_TOKEN=

# ---- 선택 ----
# 다른 사람에게 노출되는 경로(Tailscale Serve 등)로 열 때만 설정. 일반 HTTP 인터넷에 노출 금지.
DASHBOARD_PASSWORD=

# 텔레그램 전사 → /api/ingest 용. 긴 임의 문자열.
DASHBOARD_INGEST_TOKEN=

# 왼쪽 상단 이름의 초기값. 동기화하면 VPS 쪽 이름으로 바뀐다(설정에서 다시 변경 가능).
NEXT_PUBLIC_DASHBOARD_NAME=내 AI 오피스
