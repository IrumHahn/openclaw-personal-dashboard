# Optional. Set before exposing through an HTTPS reverse proxy or Tailscale Serve.
DASHBOARD_PASSWORD=

# Optional. Enables POST /api/ingest for a local Telegram/OpenClaw transcription flow.
# Use a long random value and send it only as an Authorization: Bearer header.
DASHBOARD_INGEST_TOKEN=

# Optional display name. Do not use another person's branding.
NEXT_PUBLIC_DASHBOARD_NAME=내 AI 오피스
